<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Tin tức</title>
</head>
<body>
<a href="/">Trang chủ</a> |
<a href="/about">Giới thiệu</a>
<% if(id && newsList.length > 0) {%>
<p>Bạn đang xem tin tức số <%= id %></p>
<p><%= newsList[0].title %></p>
<p><%= newsList[0].description %></p>
<% } else if(newsList.length > 0) {%>
<h1>Danh sách tin tức</h1>
<% newsList.forEach((item)=>{ %>
<ul>
<li><a href="/news/<%= item.id %>"><%= item.title %></a></li>
</ul>
<% })%>
<% } else { %>
<h1>Không tìm thấy bài viết</h1>
<% } %>
</body>
</html>
